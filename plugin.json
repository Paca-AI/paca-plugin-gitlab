{
  "id": "com.paca.gitlab",
  "displayName": "GitLab",
  "description": "GitLab provider for Paca's Git integration: access-token identities, project access, credentials and webhooks.",
  "version": "0.6.0",
  "minCoreVersion": "v0.20.0",
  "capabilities": ["git-provider"],
  "permissions": ["db.read", "db.write"],
  "backend": {
    "allowedConfigKeys": ["ENCRYPTION_KEY"],
    "allowedOutboundDomains": ["gitlab.com"],
    "sensitiveFields": {
      "gitlab_identities": ["token_enc", "read_token_enc", "webhook_secret_enc"]
    }
  }
}
